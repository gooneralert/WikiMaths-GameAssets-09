code = "shader_type spatial;
render_mode blend_mix,depth_draw_opaque,cull_back,diffuse_burley,specular_schlick_ggx,unshaded;
uniform vec4 albedo : hint_color;
uniform sampler2D texture_albedo : hint_albedo;
uniform float specular;
uniform float metallic;
uniform float roughness : hint_range(0,1);
uniform float point_size : hint_range(0,128);
uniform sampler2D texture_emission : hint_black_albedo;
uniform vec4 emission : hint_color;
uniform float emission_energy;
uniform vec3 uv1_scale;
uniform vec3 uv1_offset;
uniform vec3 uv2_scale;
uniform vec3 uv2_offset;


void vertex() {
	UV=UV*uv1_scale.xy+uv1_offset.xy;
	VERTEX.x = VERTEX.x + sin(TIME*VERTEX.y * 2.0)*0.2;
	VERTEX.z = VERTEX.z + cos(TIME*VERTEX.y* 2.0)*0.2;
	VERTEX.y = VERTEX.y + sin(TIME*VERTEX.z* 0.05)*0.7;
}




void fragment() {
	vec2 base_uv = UV;
	vec4 albedo_tex = texture(texture_albedo,base_uv*3.0);
	ALBEDO = albedo.rgb * albedo_tex.rgb * 5.0;
	ALBEDO= ALBEDO * (sin(VERTEX.z+sin(ALBEDO+TIME)+TIME));


	//ALBEDO.b = 0.0;
	METALLIC = metallic;
	ROUGHNESS = roughness;
	SPECULAR = specular;
	vec3 emission_tex = texture(texture_emission,base_uv).rgb;
	EMISSION = (emission.rgb+emission_tex)*emission_energy;
}
"

